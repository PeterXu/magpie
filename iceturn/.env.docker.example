# Docker environment variables for IceTurn
# Copy to .env.docker and edit

# TURN realm
REALM=iceturn.local

# Public IP (must be reachable from browser)
# Set to your server's LAN IP or public IP
PUBLIC_IP=192.168.1.100

# Listen ports (usually no need to change)
LISTEN_UDP=:3478
LISTEN_TCP=:3478

# Credentials
# Format: TURN_CREDENTIALS=user:password
# Multiple users: TURN_CREDENTIALS=user1:pass1,user2:pass2
TURN_CREDENTIALS=iceturn:iceturn
