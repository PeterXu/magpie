# magpie 环境变量示例
# 复制到 .env 文件并根据需要修改。由 src/env.js 在启动时自动加载。
# 真实环境变量/shell 环境变量优先于此文件。
#
# 注意：MAGPIE_NO_SANDBOX 仅用于 Docker 环境，已在 Dockerfile 和 docker-compose.yml 中硬编码为 1
# 请勿在 .env 中设置此变量，以避免沙箱配置错误

# ============================================================
# 服务器配置
# ============================================================

# 监听端口 (默认: 8080)
PORT=8080

# 监听地址 (默认: 0.0.0.0; 设置为 127.0.0.1 仅限本机访问)
HOST=0.0.0.0

# 目标页面 URL (默认: about:blank)
MAGPIE_URL=about:blank

# ============================================================
# 视频/画质配置 (均为可选，未设置则使用默认值)
# ============================================================

# 视频分辨率 (范围: 320-3840)
MAGPIE_WIDTH=1280
MAGPIE_HEIGHT=800

# JPEG 质量 (范围: 1-100, 默认: 80)
MAGPIE_QUALITY=80

# 输出帧率 - 驱动 streamer 页面的 canvas.captureStream(fps) (范围: 1-60, 默认: 10)
MAGPIE_FPS=10

# WebRTC 最大比特率 (bps)
# - 未设置: 自适应默认值 (~2.5bps/px, 范围 1.5M-8M)
# - none/off: 禁用限制
# - 支持单位: 2500k 或 2.5m
MAGPIE_MAX_BITRATE=

# WebRTC 最大帧率 (正整数，未设置则无限制)
MAGPIE_MAX_FRAMERATE=

# WebRTC 降级策略 (默认: maintain-resolution)
# 可选值: maintain-resolution, maintain-framerate, balanced
MAGPIE_DEGRADATION=maintain-resolution

# ============================================================
# TURN 中继配置 (当客户端不在同一主机时需要)
# ============================================================

# 主机局域网 IP (必须能从浏览器和容器同时访问)
MAGPIE_HOST_IP=

# TURN 服务器主机名 (Docker 默认: iceturn, 容器名或自定义主机)
MAGPIE_TURN_HOST=iceturn

# TURN 认证 (默认: magpie/magpie)
MAGPIE_TURN_USER=magpie
MAGPIE_TURN_PASS=magpie