# magpie environment. Copy to .env and edit. Auto-loaded at startup by src/env.js;
# the real / shell environment always wins over this file.
# Full reference: see CLAUDE.md (section "Env").

# --- server ---
PORT=8080
HOST=0.0.0.0
MAGPIE_URL=about:blank
# set MAGPIE_NO_SANDBOX=1 only inside Docker
MAGPIE_NO_SANDBOX=

# --- video / quality (all optional; unset = default) ---
MAGPIE_WIDTH=1280
MAGPIE_HEIGHT=800
MAGPIE_QUALITY=80
# drives canvas.captureStream(fps) on the streamer page — the real output-fps cap
MAGPIE_FPS=10
# bps; accepts 2500k / 2.5m; none/off disables. Default: adaptive (~2.5bps/px)
MAGPIE_MAX_BITRATE=
MAGPIE_MAX_FRAMERATE=
MAGPIE_DEGRADATION=maintain-resolution

# --- TURN relay (needed when the client is not on the same host) ---
# host LAN IP reachable from both the browser and the container
MAGPIE_HOST_IP=
MAGPIE_TURN_USER=magpie
MAGPIE_TURN_PASS=magpie
